DATABASE_URL=postgresql://fixoku_local:CHANGE_ME@127.0.0.1:5433/fixoku_platform_dev
TEST_DATABASE_URL=postgresql://fixoku_local:CHANGE_ME@127.0.0.1:5433/fixoku_platform_test
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
BETTER_AUTH_URL=http://127.0.0.1:5173
APP_ORIGIN=http://127.0.0.1:5173
BETTER_AUTH_TEST_MAIL_SINK=0
POSTGRES_USER=fixoku_local
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
FIXOKU_DEV_COMMERCE_SETTLEMENT_ENABLED=0
PAYMENT_PROVIDER=
EMAIL_OUTBOX_MAX_ATTEMPTS=5
# Resend SMTP uses the existing Nodemailer boundary: smtp.resend.com,
# SMTP_USER=resend and the Resend Sending API key as SMTP_PASS.
EMAIL_PROVIDER=SMTP
EMAIL_TEST_MODE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_FROM=
DIGITAL_STORAGE_PROVIDER=DISABLED
DIGITAL_STORAGE_ROOT=
# For Cloudflare R2 use DIGITAL_STORAGE_PROVIDER=R2 (or S3), the account
# endpoint below, region=auto, and the bucket-scoped key pair. The bucket must
# remain private; delivery uses short-lived signed GET URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DIGITAL_STORAGE_SIGNED_URL_TTL_SECONDS=300
# Optional alias for profile-media reads; when empty, DIGITAL_STORAGE_PROVIDER
# is reused. Local profile media remains development-only.
PROFILE_MEDIA_PROVIDER=

SHIPPING_PROVIDER=DISABLED
SHIPPING_BASE_URL=
SHIPPING_TOKEN=
SHIPPING_TIMEOUT_MS=8000

# No business carrier is selected until the official endpoint, credentials and
# provider acceptance are available. Allowed values: DISABLED, SENDEO, MNG,
# YURTICI, ARAS, KOLAYGELSIN.
CARRIER_SELECTION_REQUIRED=0

# PayTR iFrame readiness (credentials are server-only and must never be committed)
PAYTR_ENABLED=0
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_OK_URL=http://127.0.0.1:5173/api/paytr/return-success
PAYTR_FAIL_URL=http://127.0.0.1:5173/api/paytr/return-failure
PAYTR_CALLBACK_URL=http://127.0.0.1:5173/api/paytr/callback

# Consent and measurement placeholders (independent Fixoku identifiers)
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LEAD=
GOOGLE_ADS_CONVERSION_PURCHASE=
GOOGLE_ADS_CONVERSION_PHONE=
GOOGLE_ADS_CONVERSION_WHATSAPP=
GOOGLE_ADS_CONVERSION_FORM=
GOOGLE_SITE_VERIFICATION=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
# Fixoku martech configuration (placeholders only; never commit secrets)

# Local review is opt-in and must remain disabled in production.
LOCAL_REVIEW_MODE=0
VITE_LOCAL_REVIEW_MODE=0

# Production Owner login policy (R82): keep the global privileged 2FA gate
# enabled for SUPER_ADMIN and set only the approved Owner override to 0 in
# Vercel Production. Do not use this override for local review.
# FIXOKU_REQUIRE_PRIVILEGED_2FA=1
# FIXOKU_OWNER_REQUIRE_PRIVILEGED_2FA=0
